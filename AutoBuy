local autoBuyActive = false

-- Función de Clic Adaptada para PC y Móvil
local function clickSingleTarget(targetBtn)
	if firesignal and (targetBtn:IsA("TextButton") or targetBtn:IsA("ImageButton")) then
		pcall(function() firesignal(targetBtn.MouseButton1Click) end)
		pcall(function() firesignal(targetBtn.Activated) end)
		pcall(function() firesignal(targetBtn.MouseButton1Down) end)
		pcall(function() firesignal(targetBtn.MouseButton1Up) end)
	else
		-- Cálculo corregido de posición absoluta en pantalla (Compatible con PC)
		local pos = targetBtn.AbsolutePosition
		local size = targetBtn.AbsoluteSize
		local inset = game:GetService("GuiService"):GetGuiInset()
		
		local centerX = pos.X + (size.X / 2)
		local centerY = pos.Y + (size.Y / 2) + inset.Y

		VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, true, game, 1)
		task.wait(0.04)
		VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, false, game, 1)
	end
end

local function clickShopItemExact(exactKeyword)
	for _, gui in ipairs(PlayerGui:GetDescendants()) do
		if not gui:IsDescendantOf(Screengui) then
			local matched = false

			if gui:IsA("TextLabel") or gui:IsA("TextButton") then
				local txt = gui.Text:lower()
				if exactKeyword == "water" and txt == "water" then
					matched = true
				elseif exactKeyword == "gelatin" and txt == "gelatin" then
					matched = true
				elseif exactKeyword == "sugar" and (txt:find("sugar block bag") or txt == "sugar block bag") then
					matched = true
				end
			end

			if matched then
				local targetBtn = (gui:IsA("TextButton") or gui:IsA("ImageButton")) and gui or gui.Parent
				clickSingleTarget(targetBtn)
				return true
			end
		end
	end
	return false
end

BuyButton.MouseButton1Click:Connect(function()
	autoBuyActive = not autoBuyActive
	BuyButton.BackgroundColor3 = autoBuyActive and Color3.fromRGB(40, 180, 80) or Color3.fromRGB(180, 40, 40)
	BuyButton.Text = autoBuyActive and "AUTO BUY: ON" or "AUTO BUY: OFF"
end)

task.spawn(function()
	while true do
		if autoBuyActive then
			local targetAmount = tonumber(QuantityBox.Text) or 1
			targetAmount = math.clamp(targetAmount, 1, 100)
			
			local ingredients = {"water", "gelatin", "sugar"}
			
			for _, ingredientKey in ipairs(ingredients) do
				if not autoBuyActive then break end
				
				for i = 1, targetAmount do
					if not autoBuyActive then break end
					
					local success = clickShopItemExact(ingredientKey)
					if success then
						task.wait(0.45)
					else
						task.wait(0.2)
					end
				end
				
				task.wait(0.5)
			end
			
			autoBuyActive = false
			BuyButton.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
			BuyButton.Text = "AUTO BUY: OFF"
		end
		task.wait(0.5)
	end
end)
